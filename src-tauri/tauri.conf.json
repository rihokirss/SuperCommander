{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SuperCommander",
  "version": "0.4.1",
  "identifier": "ee.supercommander.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SuperCommander",
        "width": 1440,
        "height": 920,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src ipc: http://ipc.localhost; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "An elegant two-pane file manager",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Estonian"],
        "customLanguageFiles": { "Estonian": "windows/Estonian.nsh" },
        "displayLanguageSelector": true
      }
    }
  }
}
